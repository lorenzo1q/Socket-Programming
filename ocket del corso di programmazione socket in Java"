[32m+[m[32m# SOCK_STREAM: Tipo di socket per TCP (flusso affidabile)[m
[32m+[m[32mserver_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)[m
[32m+[m
[32m+[m[32m# 2. Associazione del socket a un indirizzo e porta (binding)[m
[32m+[m[32m# 'localhost' significa che il server ascolterà solo su questa macchina[m
[32m+[m[32m# 12345 è la porta su cui il server sarà disponibile[m
[32m+[m[32mserver_socket.bind(('localhost', 22345))[m
[32m+[m
[32m+[m[32m# 3. Il server inizia ad ascoltare le connessioni in entrata[m
[32m+[m[32m# Il parametro 5 indica il numero massimo di connessioni in coda[m
[32m+[m[32mserver_socket.listen(5)[m
[32m+[m[32mprint("Server in ascolto su porta 12345...")[m
[32m+[m
[32m+[m[32m# 4. Ciclo infinito per accettare e gestire connessioni multiple[m
[32m+[m[32mwhile True:[m
[32m+[m[32m    # accept() blocca l'esecuzione fino a quando un client si connette[m
[32m+[m[32m    # Restituisce un nuovo socket per la comunicazione e l'indirizzo del client[m
[32m+[m[32m    client_socket, client_address = server_socket.accept()[m
[32m+[m[32m    print(f"Connessione stabilita con il client: {client_address}")[m
[32m+[m
[32m+[m[32m    # 4a. Ricezione dei dati dal client[m
[32m+[m[32m    # recv(1024) riceve fino a 1024 byte di dati[m
[32m+[m[32m    # Se non ci sono dati, recv() restituisce una stringa vuota[m
[32m+[m[32m    data = client_socket.recv(1024)[m
[32m+[m[32m    print(f"Dati ricevuti dal client: {data.decode()}")[m
[32m+[m
[32m+[m[32m    # 4b. Invio di una risposta al client[m
[32m+[m[32m    # send() richiede dati in formato bytes, quindi usiamo una stringa byte[m
[32m+[m[32m    client_socket.send(b"Hello from server!")[m
[32m+[m
[32m+[m[32m    # 4c. Chiusura della connessione con il client[m
[32m+[m[32m    # È importante chiudere il socket per liberare risorse[m
[32m+[m[32m    client_socket.close([m
